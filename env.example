# 复制为 .env 后按需修改

# ---------------- 数据库 ----------------
# SQLite（默认，零配置启动）
DATABASE_URL=sqlite:///./talent_agent.db
# MySQL（生产推荐，需先创建数据库 talent_ai）
# DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/talent_ai

# ---------------- 大模型 ----------------
# ollama（本地）或 openai_compatible（云 API）
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# 使用云 API 时填写
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 大模型不可用时回退到规则引擎
LLM_FALLBACK_TO_RULE=true

# ---------------- 服务 ----------------
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------------- HRIS 集成（可选） ----------------
# 本地适配器默认启用；如需对接 SAP SuccessFactors，请配置以下环境变量。
# 配置完成后调用 /api/integrations/* 接口时加 ?backend=sap_successfactors。

# SAP_SF_BASE_URL=https://{tenant}.api.successfactors.com
# SAP_SF_COMPANY_ID=
# SAP_SF_AUTH_MODE=oauth   # 或 basic
# OAuth 模式
# SAP_SF_CLIENT_ID=
# SAP_SF_CLIENT_SECRET=
# SAP_SF_TOKEN_URL=https://{tenant}.auth.successfactors.com/oauth/token
# Basic 模式
# SAP_SF_USER=
# SAP_SF_PASSWORD=
